{
  "manifest_version": 3,
  "name": "Not yet. Tasks first, videos later.",
  "short_name": "Not yet.",
  "version": "6.0.0",
  "description": "Helps students achieve more in their day and manage screen time: YouTube and social media stay blocked until the work is done.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "storage",
    "alarms",
    "scripting",
    "declarativeNetRequestWithHostAccess"
  ],
  "host_permissions": [
    "*://*.youtube.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "pages/popup.html",
    "default_title": "Not yet.",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://m.youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": [
        "lib/config.js",
        "lib/night.js",
        "content/guard.js"
      ],
      "css": [
        "content/guard.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "minimum_chrome_version": "123"
}
